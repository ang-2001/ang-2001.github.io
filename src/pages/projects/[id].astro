---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('projects', ({ data }) => data.caseStudy);
  return caseStudies.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
---

<Base title={`${p.data.title} — Kyle Chen`} description={p.data.summary}>
  <article class="case-study">
    <p class="back"><a href="/#projects">← All projects</a></p>
    <h1>{p.data.title}</h1>
    <div class="tldr">
      <p class="impact">{p.data.impact}</p>
      <p>{p.data.summary}</p>
    </div>
    <p class="meta">
      {p.data.tags.join(' · ')}
      {
        p.data.repo ? (
          <>
            {' — '}
            <a href={p.data.repo}>source code</a>
          </>
        ) : (
          ' — proprietary codebase; outcomes and ownership described below'
        )
      }
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
