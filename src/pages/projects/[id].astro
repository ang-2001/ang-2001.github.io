---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import TechTags from '../../components/TechTags.astro';
import { contactIcons, uiIcons } from '../../lib/icons';
import { hasDetailPage } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects', hasDetailPage);
  return projects.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
const { repo, demo, images } = p.data;
---

<Base title={`${p.data.title} — Kyle Chen`} description={p.data.summary}>
  <article class="case-study">
    <p class="back"><a href="/#projects">← All projects</a></p>
    <h1>{p.data.title}</h1>
    <div class="tldr">
      <p class="impact">{p.data.impact}</p>
      <p>{p.data.summary}</p>
    </div>
    <TechTags items={p.data.tags} />
    {
      repo || demo ? (
        <div class="card-actions meta">
          {demo && (
            <a class="btn" href={demo}>
              <Icon class="icon" name={uiIcons.externalLink} aria-hidden="true" />
              Live demo
            </a>
          )}
          {repo && (
            <a class="btn" href={repo}>
              <Icon class="icon" name={contactIcons.github} aria-hidden="true" />
              Source code
            </a>
          )}
        </div>
      ) : (
        <p class="meta">Proprietary codebase; outcomes and ownership described below.</p>
      )
    }
    {
      images && (
        <div class="gallery">
          {images.map((img) => (
            <figure>
              <Image src={img.src} alt={img.alt} widths={[720, 1440]} sizes="(min-width: 46rem) 46rem, 100vw" />
            </figure>
          ))}
        </div>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
