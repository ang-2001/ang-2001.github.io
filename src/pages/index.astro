---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import TechTags from '../components/TechTags.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { contactIcons, uiIcons } from '../lib/icons';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const caseStudies = allProjects.filter((p) => p.data.caseStudy);
const otherProjects = allProjects.filter((p) => !p.data.caseStudy);
---

<Base
  title="Kyle Chen — Software Engineer"
  description="Software engineer specializing in design systems, performance, and CI/CD. 100+ production components, millions of CMS API calls eliminated, zero-touch releases."
>
  <section class="hero">
    <h1>Kyle Chen</h1>
    <p class="tagline">
      Software engineer who builds design systems, caching layers, and CI/CD
      pipelines that ship with numbers attached — 100+ production components,
      100K+ weekly API calls cached to near zero, releases with zero manual steps.
    </p>
    <ul class="contact-links">
      <li>
        <a class="btn" href="https://github.com/ang-2001">
          <Icon class="icon" name={contactIcons.github} aria-hidden="true" />
          GitHub
        </a>
      </li>
      <li>
        <a class="btn" href="https://www.linkedin.com/in/kyle-chen-computer-scientist/">
          <Icon class="icon" name={contactIcons.linkedin} aria-hidden="true" />
          LinkedIn
        </a>
      </li>
      <li>
        <a class="btn" href="/resume">
          <Icon class="icon" name={uiIcons.fileText} aria-hidden="true" />
          Resume
        </a>
      </li>
    </ul>
  </section>

  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills</h2>
    <div class="skills-groups">
      <div class="skills-group">
        <h3>Languages</h3>
        <TechTags items={['TypeScript', 'JavaScript', 'Python', 'Java']} />
      </div>
      <div class="skills-group">
        <h3>Frontend</h3>
        <TechTags items={['React', 'Next.js', 'Angular', 'TailwindCSS', 'Storybook', 'HTML', 'CSS']} />
      </div>
      <div class="skills-group">
        <h3>Backend &amp; Data</h3>
        <TechTags items={['Node.js', 'MongoDB', 'Express.js', 'tRPC', 'DrizzleORM', 'MySQL']} />
      </div>
      <div class="skills-group">
        <h3>DevOps &amp; AI</h3>
        <TechTags items={['GitHub Actions', 'Docker', 'GCP', 'Cloud Run', 'Cloud Build', 'Turborepo', 'Claude Code']} />
      </div>
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Case Studies</h2>
    <ul class="project-grid">
      {caseStudies.map((p) => <ProjectCard project={p} />)}
    </ul>
  </section>

  {
    otherProjects.length > 0 && (
      <section aria-labelledby="other-projects-heading">
        <h2 id="other-projects-heading">Other Projects</h2>
        <ul class="project-grid">
          {otherProjects.map((p) => <ProjectCard project={p} />)}
        </ul>
      </section>
    )
  }
</Base>
